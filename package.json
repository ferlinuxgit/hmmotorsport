{
  "name": "baseboilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "predev": "node scripts/sync-modules.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-modules.mjs",
    "build": "next build",
    "postbuild": "node scripts/check-built-styles.mjs",
    "start": "next start",
    "start:docker": "node scripts/sync-modules.mjs && next start -H 0.0.0.0 -p 3000",
    "audit": "npm audit",
    "lint": "eslint .",
    "test:smoke": "tsx scripts/smoke.ts",
    "test": "node scripts/run-unit-tests.mjs",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:e2e": "node scripts/run-playwright.mjs test",
    "test:e2e:ui": "node scripts/run-playwright.mjs test --ui",
    "pretypecheck": "node scripts/clean-generated-types.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:e2e && npm run build && npm run audit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node scripts/migrate.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "db:maintenance": "node scripts/maintenance.mjs",
    "jobs:run": "node scripts/run-jobs.mjs",
    "db:studio": "drizzle-kit studio",
    "modules:sync": "node scripts/sync-modules.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1100.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.6.25",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "nodemailer": "9.0.3",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.4.0",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.5.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "brace-expansion": "file:vendor/brace-expansion-compat"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion",
    "esbuild": "0.28.1",
    "sharp": "0.35.3",
    "next": {
      "postcss": "8.5.25"
    }
  }
}
